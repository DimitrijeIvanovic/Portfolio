<section class="section bg-surface" id="skills">
  <div class="wrap">
    <%- include("section-head", { kicker: "Skills", title: "Waarmee ik werk" }) %>

    <div class="grid grid-cols-1 gap-7 min-[621px]:grid-cols-2">
      <div>
        <h3 class="mb-3 font-display text-[15px] font-bold">Frontend</h3>
        <div class="flex flex-wrap gap-2">
          <span class="chip">HTML</span>
          <span class="chip">CSS</span>
          <span class="chip">Tailwind</span>
          <span class="chip">EJS</span>
