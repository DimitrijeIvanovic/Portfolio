        links: [{ label: "GitHub", url: "https://github.com/DimitrijeIvanovic/Bib_Project" }]
      }) %>

      <%- include("project-card", {
        type: "Individueel project",
        name: "Skivakantie-database",
        description: "Relationeel databankproject in drie deelopdrachten — van basistabellen tot views, stored procedures met transacties en een stored function.",
        tags: ["MySQL"],
        links: [{ label: "GitHub", url: "https://github.com/DimitrijeIvanovic/Skivakantie_database" }]
      }) %>
    </div>
  </div>
</section>
