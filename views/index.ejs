<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body class="bg-gray-900 text-white min-h-screen flex items-center justify-center">

    <nav class="flex justify-between items-center px-16 py-6">
        <h1 class="text-2x1 font-bold">Welcome to my portfolio</h1>
        <ul class="flex gap-8 text-gray-300">
            <li><a href="#home" class="text-cyan-400 font-medium">Home</a></li>
            <li><a href="#about" class="hover:text-cyan-400 transition">About</a></li>
            <li><a href="#skills" class="hover:text-cyan-400 transition">Skills</a></li>
            <li><a href="#contact" class="hover:text-cyan-400 transition">Contact</a></li>
        </ul>
    </nav>

    <div class="max-w-2x1 mx-auto p-8 text-center">
        <img src="../assets/04cfb131-0872-496c-a841-6195765aa23c.jpg" alt="Dimitrije Ivanovic">
        <h1 class="text-4xl font-bold mb-4"><%= name %></h1>
        <p class="text-gray-300 text-lg mb-8"><%= bio %></p>
        <div class="flex flex-wrap justify-center gap-3">
            <% skills.forEach(skill => { %>
                <span class="bg-blue-600 px-4 py-2 rounded-full text-sm font-medium"><%= skill %></span>
            <% }) %>
        </div>
    </div>
  </body>
</html>
